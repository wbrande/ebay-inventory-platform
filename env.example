# Cloudflare D1 (required for d1_tui.py and inventory-receive.py)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id

# Inventory worker (required for inventory-receive.py)
INVENTORY_WORKER_URL=https://your-worker.workers.dev
INVENTORY_API_KEY=your_admin_api_key

# eBay API (required for competitor-monitor)
EBAY_APP_ID=your_ebay_app_id
EBAY_CERT_ID=your_ebay_cert_id
EBAY_DEV_ID=your_ebay_dev_id
EBAY_USER_TOKEN=your_ebay_user_token
